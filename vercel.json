{
  "version": 2,
  "name": "omniplatform",
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "shared/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/pages/(.+)/code\\.html",
      "dest": "/pages/$1/code.html"
    },
    {
      "src": "/pages/([^/]+)/([^/]+)/code\\.html",
      "dest": "/pages/$1/$2/code.html"
    },
    {
      "src": "/setup",
      "dest": "/setup.html"
    },
    {
      "src": "/login",
      "dest": "/pages/core/login/code.html"
    },
    {
      "src": "/dashboard",
      "dest": "/pages/core/dashboard/code.html"
    },
    {
      "src": "/homepage",
      "dest": "/pages/core/homepage/code.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/shared/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
