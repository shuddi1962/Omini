{
  "version": 2,
  "name": "omniplatform",
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/pages/core/login",
      "dest": "/pages/core/login/code.html"
    },
    {
      "src": "/pages/core/dashboard",
      "dest": "/pages/core/dashboard/code.html"
    },
    {
      "src": "/pages/core/homepage",
      "dest": "/pages/core/homepage/code.html"
    },
    {
      "src": "/pages/([^/]+)/([^/]+)",
      "dest": "/pages/$1/$2/code.html"
    },
    {
      "src": "/(.*)",
      "dest": "/pages/core/homepage/code.html"
    }
  ],
  "headers": [
    {
      "source": "/shared/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
